#!/usr/bin/env php
<?php

$autoload = file_exists(__DIR__ . '/../../autoload.php')
    ? __DIR__ . '/../../autoload.php'
    : __DIR__ . '/../vendor/autoload.php';

if (! file_exists($autoload)) {
    fwrite(STDERR, "Error: Dependencies not installed. Run 'composer install' first.\n");
    exit(1);
}

require $autoload;

use Killposer\Commands\ScanCommand;
use Symfony\Component\Console\Application;

$app = new Application('killposer', '1.0.0');
$app->addCommand(new ScanCommand());
$app->setDefaultCommand('scan', true);
$app->run();
