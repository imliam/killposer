{
    "name": "imliam/killposer",
    "description": "Interactively find and delete Composer vendor directories to reclaim disk space",
    "keywords": ["composer", "vendor", "cleanup", "disk-space", "cli"],
    "homepage": "https://github.com/imliam/killposer",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "laravel/prompts": "^0.3",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Killposer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Killposer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "killposer"
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
